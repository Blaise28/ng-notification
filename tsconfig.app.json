/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["@angular/localize"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/app/global/components/user-profile/**",
    "src/app/global/components/organization-profile/**",
    "src/app/global/components/markdown-reader/**",
    "src/app/global/components/pdf-reader/**",
    "src/app/global/components/media/**",
    "src/app/global/components/otp/**"
  ]
}
